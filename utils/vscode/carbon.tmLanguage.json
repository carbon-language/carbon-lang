{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "uuid": "4568a54d-9a79-41ac-a36b-05916252763b",
  "name": "carbon",
  "scopeName": "source.carbon",
  "foldingStartMarker": "\\{\\s*$",
  "foldingStopMarker": "^\\s*\\}",
  "fileTypes": ["carbon"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#cpp-inline" },
    { "include": "#strings" },
    { "include": "#builtin-functions" },
    { "include": "#choice-definitions" },
    { "include": "#declarations" },
    { "include": "#inheritance" },
    { "include": "#type-annotation" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "Toolchain directives. The lexer only acts on one that is the whole comment and the whole line, so anything looser is an ordinary comment. The comment scope sits on a capture rather than on the rule, to leave the indentation this has to match outside it.",
          "match": "^\\s*((//)(@(?:dump-sem-ir-(?:begin|end)|include-in-dumps)))$",
          "captures": {
            "1": { "name": "comment.line.double-slash.carbon" },
            "2": { "name": "punctuation.definition.comment.carbon" },
            "3": { "name": "keyword.other.directive.carbon" }
          }
        },
        {
          "name": "comment.line.double-slash.carbon",
          "match": "(//).*$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.carbon" }
          }
        }
      ]
    },
    "cpp-inline": {
      "patterns": [
        {
          "comment": "Inline C++, block form.",
          "begin": "\\b(?:(import)\\s+(Cpp)\\s+(inline)|(inline)\\s+(Cpp))\\s*(''')([^\\s'\\\"#]*)(?:[ \\t]*((//)(?:[ \\t][^\\n]*)?)$)?",
          "end": "(''')\\s*(;)?",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.carbon" },
            "2": { "name": "support.class.carbon" },
            "3": { "name": "storage.type.carbon" },
            "4": { "name": "storage.type.carbon" },
            "5": { "name": "support.class.carbon" },
            "6": { "name": "punctuation.definition.string.begin.carbon" },
            "7": { "name": "entity.name.tag.language.carbon" },
            "8": { "name": "comment.line.double-slash.carbon" },
            "9": { "name": "punctuation.definition.comment.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" },
            "2": { "name": "punctuation.terminator.statement.carbon" }
          },
          "contentName": "meta.embedded.block.cpp",
          "patterns": [{ "include": "source.cpp" }]
        },
        {
          "comment": "Inline C++, single-line form.",
          "begin": "\\b(?:(import)\\s+(Cpp)\\s+(inline)|(inline)\\s+(Cpp))\\s*(\")",
          "end": "(\")\\s*(;)?",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.carbon" },
            "2": { "name": "support.class.carbon" },
            "3": { "name": "storage.type.carbon" },
            "4": { "name": "storage.type.carbon" },
            "5": { "name": "support.class.carbon" },
            "6": { "name": "punctuation.definition.string.begin.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" },
            "2": { "name": "punctuation.terminator.statement.carbon" }
          },
          "contentName": "meta.embedded.inline.cpp",
          "patterns": [{ "include": "source.cpp" }]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "comment": "Block string literal, with an optional file type indicator, raw at `###` level.",
          "name": "string.quoted.triple.carbon",
          "begin": "(#{3,})(''')([^\\s'\\\"#]*)(?:[ \\t]*((//)(?:[ \\t][^\\n]*)?)$)?",
          "end": "(''')\\1",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" },
            "2": { "name": "punctuation.definition.string.begin.carbon" },
            "3": { "name": "entity.name.tag.language.carbon" },
            "4": { "name": "comment.line.double-slash.carbon" },
            "5": { "name": "punctuation.definition.comment.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes-raw" }]
        },
        {
          "comment": "Block string literal, with an optional file type indicator, raw at `##` level.",
          "name": "string.quoted.triple.carbon",
          "begin": "(##)(''')([^\\s'\\\"#]*)(?:[ \\t]*((//)(?:[ \\t][^\\n]*)?)$)?",
          "end": "('''##)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" },
            "2": { "name": "punctuation.definition.string.begin.carbon" },
            "3": { "name": "entity.name.tag.language.carbon" },
            "4": { "name": "comment.line.double-slash.carbon" },
            "5": { "name": "punctuation.definition.comment.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes-2" }]
        },
        {
          "comment": "Block string literal, with an optional file type indicator, raw at `#` level.",
          "name": "string.quoted.triple.carbon",
          "begin": "(#)(''')([^\\s'\\\"#]*)(?:[ \\t]*((//)(?:[ \\t][^\\n]*)?)$)?",
          "end": "('''#)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" },
            "2": { "name": "punctuation.definition.string.begin.carbon" },
            "3": { "name": "entity.name.tag.language.carbon" },
            "4": { "name": "comment.line.double-slash.carbon" },
            "5": { "name": "punctuation.definition.comment.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes-1" }]
        },
        {
          "comment": "Block string literal, with an optional file type indicator.",
          "name": "string.quoted.triple.carbon",
          "begin": "(''')([^\\s'\\\"#]*)(?:[ \\t]*((//)(?:[ \\t][^\\n]*)?)$)?",
          "end": "(''')",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" },
            "2": { "name": "entity.name.tag.language.carbon" },
            "3": { "name": "comment.line.double-slash.carbon" },
            "4": { "name": "punctuation.definition.comment.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "comment": "A `\"\"\"` block is always an error, but highlighting it as a block string keeps the rest of the file readable.",
          "name": "string.quoted.triple.carbon",
          "begin": "(\"\"\")([^\\s'\\\"#]*)(?:[ \\t]*((//)(?:[ \\t][^\\n]*)?)$)?",
          "end": "(\"\"\")",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" },
            "2": { "name": "entity.name.tag.language.carbon" },
            "3": { "name": "comment.line.double-slash.carbon" },
            "4": { "name": "punctuation.definition.comment.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "comment": "Single-line string literal, raw at `###` level.",
          "name": "string.quoted.double.carbon",
          "begin": "(#{3,})(\")",
          "end": "(\")\\1|$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" },
            "2": { "name": "punctuation.definition.string.begin.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes-raw" }]
        },
        {
          "comment": "Single-line string literal, raw at `##` level.",
          "name": "string.quoted.double.carbon",
          "begin": "(##)(\")",
          "end": "(\"##)|$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" },
            "2": { "name": "punctuation.definition.string.begin.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes-2" }]
        },
        {
          "comment": "Single-line string literal, raw at `#` level.",
          "name": "string.quoted.double.carbon",
          "begin": "(#)(\")",
          "end": "(\"#)|$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" },
            "2": { "name": "punctuation.definition.string.begin.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes-1" }]
        },
        {
          "comment": "Single-line string literal.",
          "name": "string.quoted.double.carbon",
          "begin": "(\")",
          "end": "(\")|$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "comment": "Character literal.",
          "name": "string.quoted.single.carbon",
          "begin": "(')",
          "end": "(')|$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.carbon" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.string.end.carbon" }
          },
          "patterns": [{ "include": "#string-escapes" }]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "comment": "The lexer takes only uppercase hexadecimal digits in `\\x` and `\\u{}`.",
          "name": "constant.character.escape.carbon",
          "match": "\\\\(?:[tnr0'\\\"\\\\]|x[0-9A-F]{2}|u\\{[0-9A-F]+\\})"
        }
      ]
    },
    "string-escapes-1": {
      "patterns": [
        {
          "name": "constant.character.escape.carbon",
          "match": "\\\\#(?:[tnr0'\\\"\\\\]|x[0-9A-F]{2}|u\\{[0-9A-F]+\\})"
        }
      ]
    },
    "string-escapes-2": {
      "patterns": [
        {
          "name": "constant.character.escape.carbon",
          "match": "\\\\##(?:[tnr0'\\\"\\\\]|x[0-9A-F]{2}|u\\{[0-9A-F]+\\})"
        }
      ]
    },
    "string-escapes-raw": {
      "patterns": [
        {
          "name": "constant.character.escape.carbon",
          "match": "\\\\#{3,}(?:[tnr0'\\\"\\\\]|x[0-9A-F]{2}|u\\{[0-9A-F]+\\})"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "comment": "A builtin function is defined by naming the builtin in a string, and that string names a function rather than holding text: it is 56% of the double-quoted content in `core/`. The lookahead finds the `= \"` before the region opens, and the region cannot outlive its line, since `$` ends it.",
          "begin": "\\b(fn)\\b(?=[^\"/;]*=\\s*\")",
          "beginCaptures": {
            "1": { "name": "storage.type.carbon" }
          },
          "end": "(?=;)|$",
          "patterns": [
            {
              "match": "(=)\\s*((\")([^\"\\\\\\n]*)(\"))",
              "captures": {
                "1": { "name": "keyword.operator.carbon" },
                "2": { "name": "string.quoted.double.carbon" },
                "3": { "name": "punctuation.definition.string.begin.carbon" },
                "4": { "name": "support.function.builtin.carbon" },
                "5": { "name": "punctuation.definition.string.end.carbon" }
              }
            },
            { "include": "#declarations" },
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#type-annotation" },
            { "include": "#keywords" },
            { "include": "#literals" },
            { "include": "#numbers" },
            { "include": "#operators" },
            { "include": "#identifiers" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "The name a function declaration declares, after any qualifiers. `destroy` is a keyword naming a destructor, not a name.",
          "begin": "(?<=\\bfn)\\s+(?=(?:r#)?[A-Za-z_])",
          "end": "(?:(destroy)|((?:r#)?[A-Za-z_][A-Za-z0-9_]*))\\b(?!\\s*(?:\\[[^\\[\\]]*\\]\\s*)?(?:\\([^()]*(?:\\([^()]*(?:\\([^()]*\\)[^()]*)*\\)[^()]*)*\\)\\s*)?\\.)|(?=[^\\sA-Za-z_])|$",
          "endCaptures": {
            "1": { "name": "keyword.other.carbon" },
            "2": { "name": "entity.name.function.definition.carbon" }
          },
          "patterns": [{ "include": "#declared-name-qualifier" }]
        },
        {
          "comment": "The name a class declaration declares. The kind is on the name because some themes color a class apart from other type names; no theme tells the other kinds apart, so they share the rule below.",
          "begin": "(?<=\\bclass)\\s+(?=(?:r#)?[A-Za-z_])",
          "end": "((?:r#)?[A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*(?:\\[[^\\[\\]]*\\]\\s*)?(?:\\([^()]*(?:\\([^()]*(?:\\([^()]*\\)[^()]*)*\\)[^()]*)*\\)\\s*)?\\.)|(?=[^\\sA-Za-z_])|$",
          "endCaptures": {
            "1": { "name": "entity.name.type.class.carbon" }
          },
          "patterns": [{ "include": "#declared-name-qualifier" }]
        },
        {
          "comment": "The name the other nominal type declarations declare.",
          "begin": "(?:(?<=\\balias)|(?<=\\bconstraint)|(?<=\\binterface))\\s+(?=(?:r#)?[A-Za-z_])",
          "end": "((?:r#)?[A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*(?:\\[[^\\[\\]]*\\]\\s*)?(?:\\([^()]*(?:\\([^()]*(?:\\([^()]*\\)[^()]*)*\\)[^()]*)*\\)\\s*)?\\.)|(?=[^\\sA-Za-z_])|$",
          "endCaptures": {
            "1": { "name": "entity.name.type.carbon" }
          },
          "patterns": [{ "include": "#declared-name-qualifier" }]
        },
        {
          "comment": "`let` binds a name to a value that does not change; `var` binds one that does. A binding modifier can sit between the introducer and the name, and `_`, `self`, and `Self` keep the scope they carry everywhere else.",
          "match": "\\b(let)\\s+((?:(?:generic|ref|template|unused|var)\\s+)*)(?!_\\s*:)(r#)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:(?![=!?]))",
          "captures": {
            "1": { "name": "storage.type.carbon" },
            "2": { "name": "storage.modifier.carbon" },
            "3": { "name": "punctuation.definition.raw-identifier.carbon" },
            "4": { "name": "variable.other.constant.carbon" }
          }
        },
        {
          "match": "\\b(var)\\s+((?:(?:generic|ref|template|unused)\\s+)*)(?!(?:_|self)\\s*:)(r#)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:(?![=!?]))",
          "captures": {
            "1": { "name": "storage.type.carbon" },
            "2": { "name": "storage.modifier.carbon" },
            "3": { "name": "punctuation.definition.raw-identifier.carbon" },
            "4": { "name": "variable.other.carbon" }
          }
        },
        {
          "comment": "Package, namespace, and import names. `library` and `inline` are keywords that may follow `import`, not names, and `Core` and `Cpp` keep the scope they carry everywhere else.",
          "match": "\\b(import)\\s+(?!(?:library|inline|Core|Cpp)\\b)((?:r#)?[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.carbon" },
            "2": { "name": "entity.name.namespace.carbon" }
          }
        },
        {
          "match": "\\b(package|namespace)\\s+(?!(?:library|Core|Cpp)\\b)((?:r#)?[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.carbon" },
            "2": { "name": "entity.name.namespace.carbon" }
          }
        },
        {
          "comment": "A library name is written as a string because it can hold `/`. It names a unit of code inside a package rather than a namespace of its own, so the scope says which kind of name it is and leaves the string underneath.",
          "match": "\\b(library)\\s+((\")((?:\\\\.|[^\"\\\\\\n])*)(\"))",
          "captures": {
            "1": { "name": "storage.type.carbon" },
            "2": { "name": "string.quoted.double.carbon" },
            "3": { "name": "punctuation.definition.string.begin.carbon" },
            "4": { "name": "entity.name.namespace.library.carbon" },
            "5": { "name": "punctuation.definition.string.end.carbon" }
          }
        }
      ]
    },
    "declared-name-qualifier": {
      "patterns": [
        {
          "comment": "One qualifier on a declared name, such as `N.` or `Base(T:! type).`. A name is a qualifier when its parameter lists are followed by `.`, which is how the parser tells too. The qualifier is `entity.name.scope-resolution` nested inside `entity.name.type`, so a theme with no rule for the first gives it the type color. The parameters bind compile-time values, so they read as a type context: a binding is a parameter and anything else is a type.",
          "begin": "(((?:r#)?[A-Za-z_][A-Za-z0-9_]*))\\b(?=\\s*(?:\\[[^\\[\\]]*\\]\\s*)?(?:\\([^()]*(?:\\([^()]*(?:\\([^()]*\\)[^()]*)*\\)[^()]*)*\\)\\s*)?\\.)",
          "beginCaptures": {
            "1": { "name": "entity.name.type.carbon" },
            "2": { "name": "entity.name.scope-resolution.carbon" }
          },
          "end": "(\\.)",
          "endCaptures": {
            "1": { "name": "punctuation.separator.dot-access.carbon" }
          },
          "patterns": [{ "include": "#type-body" }]
        }
      ]
    },
    "declaration-qualifier": {
      "patterns": [
        {
          "comment": "One segment of the qualifier on a declared name, which names the scope the declaration belongs to. Syntax cannot tell a namespace from a type here, so neither scope applies.",
          "match": "((?:r#)?[A-Za-z_][A-Za-z0-9_]*)(\\.)",
          "captures": {
            "1": { "name": "entity.name.scope-resolution.carbon" },
            "2": { "name": "punctuation.separator.dot-access.carbon" }
          }
        }
      ]
    },
    "type-annotation": {
      "patterns": [
        {
          "comment": "A type expression, from the token that introduces it to the first token that cannot continue one. Carbon instantiates a generic type by calling it, so a name applied to arguments is a type here rather than a function. The region cannot outlive its line, since `$` ends it.",
          "name": "meta.type.annotation.carbon",
          "begin": "(:!)|(:\\?)|(:(?![=!?]))|((?<![A-Za-z0-9_)\\]}])\\->\\?)|((?<![A-Za-z0-9_)\\]}])\\->(?!\\?))|\\b(as)\\b|\\b(adapt)\\b|\\b(require)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.operator.type.annotation.symbolic.carbon" },
            "2": { "name": "keyword.operator.type.annotation.form.carbon" },
            "3": { "name": "keyword.operator.type.annotation.carbon" },
            "4": { "name": "keyword.operator.function-result.form.carbon" },
            "5": { "name": "keyword.operator.function-result.carbon" },
            "6": { "name": "keyword.operator.expression.as.carbon" },
            "7": { "name": "storage.type.carbon" },
            "8": { "name": "storage.type.carbon" }
          },
          "end": "(?=[,;={}\\)\\]]|[-+/%!<>|^~?@\\\\]|//|\\b(?:in|and|or|not|as|impls)\\b|$)",
          "patterns": [{ "include": "#type-body" }]
        }
      ]
    },
    "type-body": {
      "patterns": [
        {
          "comment": "Argument and grouping parentheses, which nest rather than ending the type.",
          "begin": "\\(",
          "end": "(\\))|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.parens.begin.bracket.round.carbon"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.parens.end.bracket.round.carbon"
            }
          },
          "patterns": [{ "include": "#type-body" }]
        },
        {
          "begin": "\\[",
          "end": "(\\])|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.brackets.begin.bracket.square.carbon"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.brackets.end.bracket.square.carbon"
            }
          },
          "patterns": [{ "include": "#type-body" }]
        },
        {
          "comment": "A `where` clause constrains associated members, and the `=` in one names the type a member has to be rather than starting an initializer, so it does not end the type. It ends at a `)` or `]` it did not open, so a clause inside brackets closes with them.",
          "begin": "\\bwhere\\b",
          "beginCaptures": {
            "0": { "name": "keyword.other.where.carbon" }
          },
          "end": "(?=[;{}\\)\\]]|$)",
          "patterns": [{ "include": "#type-body" }]
        },
        { "include": "#impls-clause" },
        { "include": "#comments" },
        { "include": "#strings" },
        {
          "comment": "`typeof` takes an expression, so its operand is not a type even when the `typeof` is.",
          "begin": "\\b(typeof)\\s*(\\()",
          "end": "(\\))|$",
          "beginCaptures": {
            "1": { "name": "keyword.operator.expression.typeof.carbon" },
            "2": {
              "name": "punctuation.section.parens.begin.bracket.round.carbon"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.parens.end.bracket.round.carbon"
            }
          },
          "patterns": [
            { "include": "#expression-parens" },
            { "include": "$self" }
          ]
        },
        { "include": "#keywords" },
        { "include": "#literals" },
        { "include": "#numbers" },
        {
          "comment": "A pointer type is spelled with a `*` written directly against what it points to, which is what separates it from a multiplication.",
          "name": "keyword.operator.type.pointer.carbon",
          "match": "(?<=[A-Za-z0-9_)\\]*])\\*(?!=)"
        },
        { "include": "#operators" },
        { "include": "#bindings" },
        {
          "comment": "A qualifier in a type, which `#declared-name-qualifier` scopes the same way on a declared name.",
          "name": "entity.name.type.carbon",
          "match": "(?:(?<=[A-Za-z0-9_)\\]]\\.)|(?<!\\.))\\b((?:r#)?[A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*(?:\\[[^\\[\\]]*\\]\\s*)?(?:\\([^()]*(?:\\([^()]*(?:\\([^()]*\\)[^()]*)*\\)[^()]*)*\\)\\s*)?\\.)",
          "captures": {
            "1": { "name": "entity.name.scope-resolution.carbon" }
          }
        },
        {
          "comment": "Every name written here is a type: that is what the context means, whatever the name's spelling. An argument reads the same way as the name it is applied to, which is how `Optional(Slice(i32))` comes out; a qualifier is taken by the rule above. A leading `.` designates a member of a struct type or of an interface, so a qualifier has to precede the dot.",
          "name": "entity.name.type.carbon",
          "match": "(?:(?<=[A-Za-z0-9_)\\]]\\.)|(?<!\\.))\\b(r#)?[A-Za-z_][A-Za-z0-9_]*\\b",
          "captures": {
            "1": { "name": "punctuation.definition.raw-identifier.carbon" }
          }
        },
        { "include": "#identifiers" },
        { "include": "#punctuation" }
      ]
    },
    "inheritance": {
      "patterns": [
        {
          "comment": "An `impl` declaration names the type it implements the interface for, then the interface after `as`. The declaration needs a region of its own so that this `as` reads as the interface rather than as a cast, and `impl` before another introducer is a modifier rather than this. The region cannot outlive its line, since `$` ends it.",
          "begin": "\\b(impl)\\b(?!\\s*(?:adapt|alias|base|choice|class|constraint|export|fn|impl|import|interface|let|library|match_first|namespace|observe|package|require|var)\\b)",
          "beginCaptures": {
            "1": { "name": "storage.type.carbon" }
          },
          "end": "(?=[;{]|$)",
          "patterns": [
            {
              "name": "meta.inheritance-clause.carbon",
              "begin": "\\b(as)\\b",
              "beginCaptures": {
                "1": { "name": "keyword.operator.expression.as.carbon" }
              },
              "end": "(?=[,;={}\\)\\]]|[-+/%!<>|^~?@\\\\]|//|\\b(?:in|and|or|not|as|impls)\\b|$)",
              "patterns": [{ "include": "#inheritance-body" }]
            },
            { "include": "#type-body" }
          ],
          "name": "meta.type.annotation.carbon"
        },
        {
          "comment": "A `base` declaration names the class it extends. `.base` names the base class subobject instead, and `base class` modifies a declaration, so neither reaches this.",
          "name": "meta.inheritance-clause.carbon",
          "begin": "(?<!\\.)\\b(base)\\s*(:)(?![=!?])",
          "beginCaptures": {
            "1": { "name": "storage.type.carbon" },
            "2": { "name": "keyword.operator.type.annotation.carbon" }
          },
          "end": "(?=[,;={}\\)\\]]|[-+/%!<>|^~?@\\\\]|//|\\b(?:in|and|or|not|as|impls)\\b|$)",
          "patterns": [{ "include": "#inheritance-body" }]
        },
        { "include": "#impls-clause" }
      ]
    },
    "impls-clause": {
      "patterns": [
        {
          "comment": "`impls` requires a type to implement an interface.",
          "name": "meta.inheritance-clause.carbon",
          "begin": "\\b(impls)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.operator.expression.impls.carbon" }
          },
          "end": "(?=[,;={}\\)\\]]|[-+/%!<>|^~?@\\\\]|//|\\b(?:in|and|or|not|as|impls)\\b|$)",
          "patterns": [{ "include": "#inheritance-body" }]
        }
      ]
    },
    "inheritance-body": {
      "patterns": [
        {
          "comment": "Only the interface itself is the one being implemented. Its arguments are ordinary types, so an argument list switches back to `#type-body`.",
          "begin": "\\(",
          "end": "(\\))|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.parens.begin.bracket.round.carbon"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.parens.end.bracket.round.carbon"
            }
          },
          "patterns": [{ "include": "#type-body" }]
        },
        {
          "comment": "A `where` clause constrains the interface named before it, and what it names are ordinary types. It ends at a `)` or `]` it did not open, so a clause inside brackets closes with them.",
          "begin": "\\b(where)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.other.where.carbon" }
          },
          "end": "(?=[;{}\\)\\]]|$)",
          "patterns": [{ "include": "#type-body" }]
        },
        { "include": "#keywords" },
        { "include": "#literals" },
        {
          "comment": "The last segment of a qualified name is the interface; a qualifier ahead of it reads as one does in any type. A keyword written here keeps the scope it carries everywhere else, which is why `#keywords` and `#literals` come first.",
          "name": "entity.other.inherited-class.carbon",
          "match": "\\b(?:r#)?[A-Za-z_][A-Za-z0-9_]*\\b(?!\\s*\\.)"
        },
        { "include": "#type-body" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "`.base` names the base class subobject, so it comes ahead of the rules that read `base` as an introducer.",
          "name": "keyword.other.base.carbon",
          "match": "(?<=\\.)\\b(base)\\b"
        },
        {
          "comment": "`import` names a library this file depends on rather than declaring anything in it, which is the reading the Go, TypeScript, Swift, and Python grammars all give their own import keyword.",
          "name": "keyword.control.import.carbon",
          "match": "\\b(import)\\b"
        },
        {
          "name": "storage.type.carbon",
          "match": "\\b(adapt|alias|choice|class|constraint|fn|inline|interface|let|library|match_first|namespace|observe|require|var)\\b"
        },
        {
          "comment": "`base` introduces a base class declaration unless it modifies one.",
          "name": "storage.type.carbon",
          "match": "\\b(base)\\b(?!\\s*class\\b)"
        },
        {
          "name": "storage.type.carbon",
          "match": "\\b(export)\\b(?!\\s*import\\b)"
        },
        {
          "name": "storage.type.carbon",
          "match": "\\b(impl)\\b(?!\\s*(adapt|alias|base|choice|class|constraint|export|fn|impl|import|interface|let|library|match_first|namespace|observe|package|require|var)\\b)"
        },
        {
          "comment": "`package` is an introducer unless it begins a qualified name.",
          "name": "storage.type.carbon",
          "match": "\\b(package)\\b(?!\\.)"
        },
        {
          "name": "storage.modifier.carbon",
          "match": "\\b(abstract|const|eval|extend|extern|final|generic|musteval|override|partial|private|protected|ref|runtime|static|template|unsafe|unused|val|virtual)\\b"
        },
        {
          "comment": "`default` is a declaration modifier unless it opens a match arm.",
          "name": "storage.modifier.carbon",
          "match": "\\b(default)\\b(?!\\s*=>)"
        },
        {
          "name": "storage.modifier.carbon",
          "match": "\\b(base)\\b(?=\\s*class\\b)"
        },
        {
          "name": "storage.modifier.carbon",
          "match": "\\b(export)\\b(?=\\s*import\\b)"
        },
        {
          "name": "storage.modifier.carbon",
          "match": "\\b(impl)\\b(?=\\s*(adapt|alias|base|choice|class|constraint|export|fn|impl|import|interface|let|library|match_first|namespace|observe|package|require|var)\\b)"
        },
        {
          "name": "keyword.control.carbon",
          "match": "\\b(break|case|continue|else|for|if|match|return|returned|then|while)\\b"
        },
        {
          "comment": "`default` is a match arm here, and a declaration modifier elsewhere.",
          "name": "keyword.control.carbon",
          "match": "\\b(default)\\b(?=\\s*=>)"
        },
        {
          "comment": "`and` and `or` short circuit, so they branch and belong with the other control flow. `not` only negates, so it is a word operator like `as`.",
          "name": "keyword.control.carbon",
          "match": "\\b(and|or)\\b"
        },
        {
          "name": "keyword.operator.expression.not.carbon",
          "match": "\\b(not)\\b"
        },
        {
          "comment": "`as` and `impls` also introduce a type, and `#type-annotation` scopes them when they do.",
          "name": "keyword.operator.expression.as.carbon",
          "match": "\\b(as)\\b"
        },
        {
          "name": "keyword.operator.expression.impls.carbon",
          "match": "\\b(impls)\\b"
        },
        {
          "name": "keyword.operator.expression.in.carbon",
          "match": "\\b(in)\\b"
        },
        {
          "name": "keyword.operator.expression.like.carbon",
          "match": "\\b(like)\\b"
        },
        {
          "name": "keyword.operator.expression.typeof.carbon",
          "match": "\\b(typeof)\\b"
        },
        { "name": "keyword.other.where.carbon", "match": "\\b(where)\\b" },
        {
          "name": "keyword.other.carbon",
          "match": "\\b(destroy|each|expand|forall|form|friend)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        { "name": "variable.language.carbon", "match": "\\b(self|Self)\\b" },
        {
          "comment": "The wildcard pattern.",
          "name": "variable.language.carbon",
          "match": "\\b(_)\\b"
        },
        {
          "comment": "Language-provided package roots.",
          "name": "support.class.carbon",
          "match": "\\b(Core|Cpp)\\b"
        },
        {
          "comment": "`package` as a qualified-name root names the current package.",
          "name": "variable.language.carbon",
          "match": "\\b(package)\\b(?=\\.)"
        },
        { "name": "constant.language.carbon", "match": "\\b(true|false)\\b" },
        {
          "comment": "`array` builds a type, `auto` stands in for one, and `type` is the type of types, so none of the three is a primitive.",
          "name": "support.type.builtin.carbon",
          "match": "\\b(array|auto|type)\\b"
        },
        {
          "name": "support.type.primitive.carbon",
          "match": "\\b(bool|char|str)\\b"
        },
        {
          "comment": "Integer and float type literals. The lexer accepts any width with no leading zero, so this must not be restricted to the common ones.",
          "name": "support.type.primitive.carbon",
          "match": "\\b[iuf][1-9][0-9]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "comment": "The lexer scans a whole alphanumeric word starting with a digit as one literal, so these do too: a malformed spelling reads as one bad number rather than as a number stuck to an identifier. A radix point needs an alphanumeric after it, and an exponent sign needs a lowercase `e` or `p` before it. A literal written directly after `.` or `->` never forms a real, which is what makes `t.0.Op()` a member access.",
          "name": "constant.numeric.hex.carbon",
          "match": "(?<!\\.)(?<!->)\\b(0x)[_0-9A-Za-z]*\\.[0-9A-Za-z][_0-9A-Za-z]*(?:(?<=[a-z])[-+][0-9A-Za-z][_0-9A-Za-z]*)?",
          "captures": {
            "1": { "name": "keyword.other.unit.hexadecimal.carbon" }
          }
        },
        {
          "name": "constant.numeric.hex.carbon",
          "match": "\\b(0x)[_0-9A-Za-z]*",
          "captures": {
            "1": { "name": "keyword.other.unit.hexadecimal.carbon" }
          }
        },
        {
          "name": "constant.numeric.octal.carbon",
          "match": "\\b(0o)[_0-9A-Za-z]*",
          "captures": {
            "1": { "name": "keyword.other.unit.octal.carbon" }
          }
        },
        {
          "name": "constant.numeric.binary.carbon",
          "match": "\\b(0b)[_0-9A-Za-z]*",
          "captures": {
            "1": { "name": "keyword.other.unit.binary.carbon" }
          }
        },
        {
          "name": "constant.numeric.decimal.carbon",
          "match": "(?<!\\.)(?<!->)\\b[0-9][_0-9A-Za-z]*\\.[0-9A-Za-z][_0-9A-Za-z]*(?:(?<=[a-z])[-+][0-9A-Za-z][_0-9A-Za-z]*)?"
        },
        {
          "name": "constant.numeric.decimal.carbon",
          "match": "\\b[0-9][_0-9A-Za-z]*"
        },
        {
          "comment": "Positional parameter, as used in lambdas.",
          "name": "variable.parameter.carbon",
          "match": "\\$[0-9]+"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "Each rule guards its own spelling with a lookahead, so that a longer operator is never split by a shorter one listed ahead of it.",
          "name": "keyword.operator.type.annotation.symbolic.carbon",
          "match": ":!"
        },
        {
          "name": "keyword.operator.type.annotation.form.carbon",
          "match": ":\\?"
        },
        {
          "name": "keyword.operator.type.annotation.carbon",
          "match": ":(?![=!?])"
        },
        {
          "comment": "`->` reaches through a pointer to a member when it is written against the pointer, and introduces a result type when it is not.",
          "name": "punctuation.separator.pointer-access.carbon",
          "match": "(?<=[A-Za-z0-9_)\\]}])\\->(?!\\?)"
        },
        {
          "name": "keyword.operator.function-result.form.carbon",
          "match": "\\->\\?"
        },
        {
          "name": "keyword.operator.function-result.carbon",
          "match": "\\->(?!\\?)"
        },
        { "name": "keyword.operator.arrow.fat.carbon", "match": "=>" },
        {
          "name": "keyword.operator.carbon",
          "match": "<=>|<<=|>>=|==|!=|<=|>=|<<|>>|\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|~=|:=|<-|<>|[-+*/%&|^~!<>=@?\\\\]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        { "include": "#bindings" },
        {
          "comment": "Raw identifiers, which suppress keyword meaning.",
          "name": "variable.other.carbon",
          "match": "\\b(r#)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.raw-identifier.carbon" }
          }
        },
        {
          "comment": "A member applied to an argument list is a call on that member.",
          "name": "entity.name.function.member.carbon",
          "match": "(?:(?<=\\.)|(?<=\\->))[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "comment": "A member read through `.` or `->`. Nothing here says whether it names a type: in Carbon a name is a type because of where it is written, which `#type-body` is what marks.",
          "name": "variable.other.property.carbon",
          "match": "(?:(?<=\\.)|(?<=\\->))[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        {
          "comment": "A name applied to an argument list is a call.",
          "name": "entity.name.function.call.carbon",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.carbon",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "comment": "Brackets are named by shape. Which role a bracket plays is not decidable without tracking every region it can open, and the grammar keeps regions to the few places a terminator reliably turns up.",
          "name": "punctuation.section.parens.begin.bracket.round.carbon",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.bracket.round.carbon",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.block.begin.bracket.curly.carbon",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.bracket.curly.carbon",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.bracket.square.carbon",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.bracket.square.carbon",
          "match": "\\]"
        },
        { "name": "punctuation.separator.dot-access.carbon", "match": "\\." },
        { "name": "punctuation.separator.comma.carbon", "match": "," },
        { "name": "punctuation.terminator.statement.carbon", "match": ";" }
      ]
    },
    "choice-definitions": {
      "patterns": [
        {
          "comment": "A choice declaration, so that the names in its body read as the alternatives they declare. The region ends after the body, or at the first token that can neither continue the head nor open the body, so a choice with no definition closes on the spot.",
          "begin": "\\b(choice)\\b",
          "beginCaptures": {
            "1": { "name": "storage.type.carbon" }
          },
          "end": "(?<=\\})|(?=[^\\s({])",
          "patterns": [
            {
              "begin": "(?<=\\bchoice)\\s+(?=(?:r#)?[A-Za-z_])",
              "end": "((?:r#)?[A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*(?:\\[[^\\[\\]]*\\]\\s*)?(?:\\([^()]*(?:\\([^()]*(?:\\([^()]*\\)[^()]*)*\\)[^()]*)*\\)\\s*)?\\.)|(?=[^\\sA-Za-z_])|$",
              "endCaptures": {
                "1": { "name": "entity.name.type.carbon" }
              },
              "patterns": [{ "include": "#declared-name-qualifier" }]
            },
            { "include": "#comments" },
            {
              "comment": "The choice's own parameters.",
              "begin": "\\(",
              "end": "(\\))|$",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.parens.begin.bracket.round.carbon"
                }
              },
              "endCaptures": {
                "1": {
                  "name": "punctuation.section.parens.end.bracket.round.carbon"
                }
              },
              "patterns": [{ "include": "#choice-parameters" }]
            },
            {
              "comment": "The body holds nothing but alternatives, each a name with an optional parameter list.",
              "begin": "\\{",
              "end": "(\\})|(?=[;=])",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.block.begin.bracket.curly.carbon"
                }
              },
              "endCaptures": {
                "1": {
                  "name": "punctuation.section.block.end.bracket.curly.carbon"
                }
              },
              "patterns": [
                { "include": "#comments" },
                {
                  "comment": "An alternative's own parameters.",
                  "begin": "\\(",
                  "end": "(\\))|$",
                  "beginCaptures": {
                    "0": {
                      "name": "punctuation.section.parens.begin.bracket.round.carbon"
                    }
                  },
                  "endCaptures": {
                    "1": {
                      "name": "punctuation.section.parens.end.bracket.round.carbon"
                    }
                  },
                  "patterns": [{ "include": "#choice-parameters" }]
                },
                {
                  "comment": "An alternative cannot take implicit parameters, but reads better than the rest of the file would if it does.",
                  "begin": "\\[",
                  "end": "(\\])|$",
                  "beginCaptures": {
                    "0": {
                      "name": "punctuation.section.brackets.begin.bracket.square.carbon"
                    }
                  },
                  "endCaptures": {
                    "1": {
                      "name": "punctuation.section.brackets.end.bracket.square.carbon"
                    }
                  },
                  "patterns": [{ "include": "#choice-parameters" }]
                },
                { "include": "#keywords" },
                { "include": "#literals" },
                {
                  "name": "variable.other.enummember.carbon",
                  "match": "\\b(?:r#)?[A-Za-z_][A-Za-z0-9_]*\\b"
                },
                { "include": "#numbers" },
                { "include": "#operators" },
                { "include": "#punctuation" }
              ]
            }
          ]
        }
      ]
    },
    "choice-parameters": {
      "comment": "What a pattern list holds, wherever a choice declaration has one.",
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#inheritance" },
        { "include": "#type-annotation" },
        { "include": "#keywords" },
        { "include": "#literals" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#identifiers" },
        { "include": "#punctuation" }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "comment": "A name written directly before its type is bound here rather than used, which is how Carbon writes a parameter. `#declarations` takes the `let` and `var` forms before this is reached. The scope sits on a capture inside `variable.other`, so a theme that styles only the broader name still colors it.",
          "name": "variable.other.carbon",
          "match": "(?<!\\.)(?<!->)\\b(r#)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:(?![=!?]))",
          "captures": {
            "1": { "name": "punctuation.definition.raw-identifier.carbon" },
            "2": { "name": "variable.parameter.carbon" }
          }
        }
      ]
    },
    "expression-parens": {
      "patterns": [
        {
          "comment": "Parentheses nested in an expression that sits inside a type, so that only the matching `)` ends the expression.",
          "begin": "\\(",
          "end": "(\\))|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.parens.begin.bracket.round.carbon"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.parens.end.bracket.round.carbon"
            }
          },
          "patterns": [
            { "include": "#expression-parens" },
            { "include": "$self" }
          ]
        }
      ]
    }
  }
}
