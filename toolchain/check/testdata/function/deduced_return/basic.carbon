//
// AUTOUPDATE
// TIP: To test this file alone, run:
// TIP:   bazel test //toolchain/testing:file_test --test_arg=--file_tests=toolchain/check/testdata/function/deduced_return/basic.carbon
// TIP: To dump output, run:
// TIP:   bazel run //toolchain/testing:file_test -- --dump_output --file_tests=toolchain/check/testdata/function/deduced_return/basic.carbon

// --- single_return.carbon
library "[[@TEST_NAME]]";

//@dump-sem-ir-begin
fn F() -> auto {
  return 0 as i32;
}

fn G() -> i32 {
  return F();
}
//@dump-sem-ir-end

// --- multiple_returns.carbon
library "[[@TEST_NAME]]";

fn F(b: bool) -> auto {
  if (b) {
    return 1 as i32;
  }
  return 2 as i32;
}

fn G() -> i32 {
  return F(true);
}

// --- int_literal.carbon
library "[[@TEST_NAME]]";

// Literal types are not decayed.
fn F() -> auto {
  return 0;
}

fn G() -> Core.IntLiteral {
  return F();
}

// --- in_place.carbon
library "[[@TEST_NAME]]";

class C {
  var a: i32;
  var b: i32;
}

//@dump-sem-ir-begin
fn F() -> auto {
  return {.a = 1, .b = 2} as C;
}

fn G() -> C {
  return F();
}
//@dump-sem-ir-end

// --- type.carbon
library "[[@TEST_NAME]]";

eval fn F() -> auto {
  return i32;
}

var n: F() = 0;

// --- nested.carbon
library "[[@TEST_NAME]]";

fn F() -> auto {
  fn G() -> auto {
    return 1 as i32;
  }
  return G();
}

fn H() -> i32 {
  return F();
}

// --- lambda.carbon
library "[[@TEST_NAME]]";

fn F() -> i32 {
  //@dump-sem-ir-begin
  alias lambda = fn (x: i32) -> auto { return x; };
  return lambda(1);
  //@dump-sem-ir-end
}

// --- lambda_no_params.carbon
library "[[@TEST_NAME]]";

fn F() -> i32 {
  alias lambda = fn () -> auto { return 1 as i32; };
  return lambda();
}

// --- member.carbon
library "[[@TEST_NAME]]";

class C {
  fn F() -> auto { return 1 as i32; }
  fn G(self) -> auto { return self.n; }
  // The body of `F` is checked before the body of `H`.
  fn H() -> i32 { return F(); }
  var n: i32;
}

fn Use(c: C) -> i32 {
  return c.G();
}

// --- unreachable_end.carbon
library "[[@TEST_NAME]]";

fn F(b: bool) -> auto {
  if (b) {
    return 1 as i32;
  } else {
    return 2 as i32;
  }
}

fn G() -> i32 {
  return F(false);
}

