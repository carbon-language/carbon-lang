// --- returned_var.carbon
library "[[@TEST_NAME]]";

//@dump-sem-ir-begin
fn F() -> auto {
  returned var r: i32 = 0;
  return var;
}
//@dump-sem-ir-end

fn G() -> i32 {
  return F();
}

// --- returned_var_after_return.carbon
library "[[@TEST_NAME]]";

//@dump-sem-ir-begin
fn F(b: bool) -> auto {
  if (b) {
    // This is converted to the type of the `returned var`.
    return 1;
  }
  returned var r: i32 = 0;
  return var;
}
//@dump-sem-ir-end

fn G() -> i32 {
  return F(true);
}

// --- return_after_returned_var.carbon
library "[[@TEST_NAME]]";

fn F(b: bool) -> auto {
  if (b) {
    returned var r: i32 = 0;
    return var;
  }
  // This is converted to the type of the `returned var`.
  return 1;
}

fn G() -> i32 {
  return F(true);
}

// --- returned_var_in_place.carbon
library "[[@TEST_NAME]]";

class C {
  var a: i32;
  var b: i32;
}

//@dump-sem-ir-begin
fn F() -> auto {
  // The `returned var` is initialized in the return slot.
  returned var c: C = {.a = 1, .b = 2};
  return var;
}
//@dump-sem-ir-end

// --- fail_return_before_returned_var.carbon
library "[[@TEST_NAME]]";

fn F(b: bool) -> auto {
  if (b) {
    // CHECK:STDERR: fail_return_before_returned_var.carbon:[[@LINE+6]]:5: error: cannot implicitly convert expression of type `bool` to `i32` [ConversionFailure]
    // CHECK:STDERR:     return true;
    // CHECK:STDERR:     ^~~~~~~~~~~~
    // CHECK:STDERR: fail_return_before_returned_var.carbon:[[@LINE+3]]:5: note: type `bool` does not implement interface `Core.ImplicitAs(i32)` [MissingImplInMemberAccessInContext]
    // CHECK:STDERR:     return true;
    // CHECK:STDERR:     ^~~~~~~~~~~~
    return true;
  }
  // CHECK:STDERR: fail_return_before_returned_var.carbon:[[@LINE+4]]:19: note: return type deduced as `i32` here [ReturnTypeDeducedHere]
  // CHECK:STDERR:   returned var r: i32 = 0;
  // CHECK:STDERR:                   ^~~
  // CHECK:STDERR:
  returned var r: i32 = 0;
  return var;
}

// --- fail_returned_var_mismatch.carbon
library "[[@TEST_NAME]]";

fn F(b: bool) -> auto {
  if (b) {
    returned var r: i32 = 0;
    return var;
  }
  // CHECK:STDERR: fail_returned_var_mismatch.carbon:[[@LINE+7]]:19: error: type `bool` of `returned var` does not match return type of enclosing function [ReturnedVarWrongType]
  // CHECK:STDERR:   returned var s: bool = true;
  // CHECK:STDERR:                   ^~~~
  // CHECK:STDERR: fail_returned_var_mismatch.carbon:[[@LINE-6]]:21: note: return type of function is `i32` [ReturnTypeHereNote]
  // CHECK:STDERR:     returned var r: i32 = 0;
  // CHECK:STDERR:                     ^~~
  // CHECK:STDERR:
  returned var s: bool = true;
  return var;
}

