// --- fail_this_lib.carbon

package This library "[[@TEST_NAME]]";

// CHECK:STDERR: fail_this_lib.carbon:[[@LINE+4]]:1: error: file cannot import itself [ImportSelf]
// CHECK:STDERR: import library "this_lib";
// CHECK:STDERR: ^~~~~~~~~~~~~~~~~~~~~~~~~~
