// --- implicit.carbon

package Implicit;

fn A();

// --- implicit.impl.carbon

impl package Implicit;

var a: () = A();

var package_a: () = package.A();

// --- same_package.carbon

package SamePackage;

fn B();

// --- same_package_importer.carbon

package SamePackage library "[[@TEST_NAME]]";

import library default;

var b: () = B();

var package_b: () = package.B();

