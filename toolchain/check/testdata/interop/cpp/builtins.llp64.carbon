// --- arithmetic_homogeneous_unsigned_long.carbon

library "[[@TEST_NAME]]";

import Cpp;

fn AssertSameType[T:! type](a: T, b: T) {}

fn ArithmeticHomogeneousUnsignedLong() {
  //@dump-sem-ir-begin
  let x: Cpp.unsigned_long = 1;
  let y: Cpp.unsigned_long = 1;

  AssertSameType(-x, x);
  AssertSameType(x + y, x);
  AssertSameType(x - y, x);
  AssertSameType(x * y, x);
