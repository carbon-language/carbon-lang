// --- clang_codegen.h

#include <vector>
#include <string>
#include <memory>
#include <iostream>

// Complex C++ functions with various signatures for testing code generation
auto calculate_statistics(std::vector<double>& data, double* mean, double* stddev) -> bool;
auto process_image_data(const unsigned char* pixels, size_t width, size_t height, 
                       std::string& metadata) -> std::unique_ptr<std::vector<int>>;
auto matrix_multiply(const double* a, const double* b, double* result, 
                    size_t rows, size_t cols) -> void;
auto complex_callback_function(int (*callback)(const char*, void*), void* user_data) -> int;

// Template function for advanced interop testing
template<typename T>
auto generic_processor(const std::vector<T>& input, T& output) -> bool;

// Function with references and multiple output parameters
auto advanced_parsing(const std::string& input, int& parsed_count, 
                     std::vector<std::string>& tokens, bool& success) -> void;

// --- import_clang_codegen.carbon

library "[[@TEST_NAME]]";

import Cpp library "clang_codegen.h";

// Carbon wrappers demonstrating Clang-generated code
fn TestCalculateStatistics() -> Bool {
  var data: Array(f64) = Array(f64)();
  data.Push(1.0);
  data.Push(2.0);
  data.Push(3.0);
  data.Push(4.0);
  data.Push(5.0);
  
  var mean: f64 = 0.0;
  var stddev: f64 = 0.0;
  
  // This would be generated by ClangCodeGenerator for signature:
  // bool calculate_statistics(std::vector<double>& data, double* mean, double* stddev)
  var success: Bool = Cpp.calculate_statistics(data, &mean, &stddev);
  
  return success;
}

fn TestProcessImageData() -> Bool {
  // Create sample image data
  var pixels: Array(u8) = Array(u8)();
  var i: i32 = 0;
  while (i < 1000) {
    pixels.Push(Cast(u8, i % 256));
    i = i + 1;
  }
  
  var metadata: String = "RGB Test Image";
  
  // This would be generated by ClangCodeGenerator for signature:
  // std::unique_ptr<std::vector<int>> process_image_data(const unsigned char* pixels, 
  //                                                      size_t width, size_t height, 
  //                                                      std::string& metadata)
  var result: Cpp.unique_ptr(Cpp.vector(i32)) = 
    Cpp.process_image_data(pixels.Begin(), 32, 32, metadata);
  
  return result != nullptr;
}

fn TestMatrixMultiply() {
  // 2x2 matrix multiplication test
  var matrix_a: Array(f64) = Array(f64)();
  matrix_a.Push(1.0);
  matrix_a.Push(2.0);
  matrix_a.Push(3.0);
  matrix_a.Push(4.0);
  
  var matrix_b: Array(f64) = Array(f64)();
  matrix_b.Push(5.0);
  matrix_b.Push(6.0);
  matrix_b.Push(7.0);
  matrix_b.Push(8.0);
  
  var result: Array(f64) = Array(f64)();
  result.Resize(4);
  
  // This would be generated by ClangCodeGenerator for signature:
  // void matrix_multiply(const double* a, const double* b, double* result, 
  //                      size_t rows, size_t cols)
  Cpp.matrix_multiply(matrix_a.Begin(), matrix_b.Begin(), result.Begin(), 2, 2);
}

fn TestAdvancedParsing() {
  var input: String = "token1,token2,token3";
  var parsed_count: i32 = 0;
  var tokens: Array(String) = Array(String)();
  var success: Bool = false;
  
  // This would be generated by ClangCodeGenerator for signature:
  // void advanced_parsing(const std::string& input, int& parsed_count,
  //                       std::vector<std::string>& tokens, bool& success)
  Cpp.advanced_parsing(input, &parsed_count, tokens, &success);
}

// Demonstration of auto-generated wrapper patterns
fn ShowGeneratedWrapperPatterns() {
  // Pattern 1: C++ reference parameters -> Carbon address parameters
  // C++: void func(Type& param)  ->  Carbon: fn Func(param: Addr(Type))
  
  // Pattern 2: C++ pointer parameters -> Carbon optional address
  // C++: void func(Type* param)  ->  Carbon: fn Func(param: Optional(Addr(Type)))
  
  // Pattern 3: C++ return pointers -> Carbon optional values  
  // C++: Type* func()  ->  Carbon: fn Func() -> Optional(Type)
  
  // Pattern 4: C++ containers -> Carbon arrays
  // C++: std::vector<T>&  ->  Carbon: Array(T)
  
  // Pattern 5: C++ strings -> Carbon strings
  // C++: std::string&  ->  Carbon: String
}

// --- clang_codegen.cpp

#include "clang_codegen.h"
#include <algorithm>
#include <numeric>
#include <cmath>

auto calculate_statistics(std::vector<double>& data, double* mean, double* stddev) -> bool {
    if (data.empty() || !mean || !stddev) {
        return false;
    }
    
    // Calculate mean
    *mean = std::accumulate(data.begin(), data.end(), 0.0) / data.size();
    
    // Calculate standard deviation
    double variance = 0.0;
    for (const auto& value : data) {
        variance += (value - *mean) * (value - *mean);
    }
    variance /= data.size();
    *stddev = std::sqrt(variance);
    
    std::cout << "Statistics calculated - Mean: " << *mean << ", StdDev: " << *stddev << "\n";
    return true;
}

auto process_image_data(const unsigned char* pixels, size_t width, size_t height,
                       std::string& metadata) -> std::unique_ptr<std::vector<int>> {
    if (!pixels) {
        return nullptr;
    }
    
    auto result = std::make_unique<std::vector<int>>();
    result->reserve(width * height);
    
    // Simple image processing: convert to grayscale values
    for (size_t i = 0; i < width * height; ++i) {
        result->push_back(static_cast<int>(pixels[i]));
    }
    
    metadata += " (Processed by C++)";
    
    std::cout << "Processed " << width << "x" << height << " image\n";
    std::cout << "Updated metadata: " << metadata << "\n";
    
    return result;
}

auto matrix_multiply(const double* a, const double* b, double* result,
                    size_t rows, size_t cols) -> void {
    if (!a || !b || !result) {
        return;
    }
    
    // Simple matrix multiplication (assuming square matrices for simplicity)
    for (size_t i = 0; i < rows; ++i) {
        for (size_t j = 0; j < cols; ++j) {
            result[i * cols + j] = 0.0;
            for (size_t k = 0; k < cols; ++k) {
                result[i * cols + j] += a[i * cols + k] * b[k * cols + j];
            }
        }
    }
    
    std::cout << "Matrix multiplication completed for " << rows << "x" << cols << " matrices\n";
}

auto complex_callback_function(int (*callback)(const char*, void*), void* user_data) -> int {
    if (!callback) {
        return -1;
    }
    
    std::cout << "Calling callback function\n";
    return callback("Test message from C++", user_data);
}

// Template instantiations for testing
template auto generic_processor<int>(const std::vector<int>& input, int& output) -> bool;
template auto generic_processor<double>(const std::vector<double>& input, double& output) -> bool;

template<typename T>
auto generic_processor(const std::vector<T>& input, T& output) -> bool {
    if (input.empty()) {
        return false;
    }
    
    output = *std::max_element(input.begin(), input.end());
    std::cout << "Generic processor found max element: " << output << "\n";
    return true;
}

auto advanced_parsing(const std::string& input, int& parsed_count,
                     std::vector<std::string>& tokens, bool& success) -> void {
    tokens.clear();
    parsed_count = 0;
    success = false;
    
    if (input.empty()) {
        return;
    }
    
    // Simple tokenization by comma
    std::string current_token;
    for (char c : input) {
        if (c == ',') {
            if (!current_token.empty()) {
                tokens.push_back(current_token);
                current_token.clear();
                parsed_count++;
            }
        } else {
            current_token += c;
        }
    }
    
    // Add last token
    if (!current_token.empty()) {
        tokens.push_back(current_token);
        parsed_count++;
    }
    
    success = parsed_count > 0;
    
    std::cout << "Parsed " << parsed_count << " tokens from: \"" << input << "\"\n";
    for (const auto& token : tokens) {
        std::cout << "  Token: \"" << token << "\"\n";
    }
}

