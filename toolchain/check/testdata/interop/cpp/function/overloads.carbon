// ============================================================================
// Single function
// ============================================================================

// --- single_function.h

auto foo(short a) -> void;

// --- import_single_function.carbon

library "[[@TEST_NAME]]";

import Cpp library "single_function.h";

fn F() {
  Cpp.foo(1 as i16);
}

// ============================================================================
// Multiple functions (no overload)
// ============================================================================

// --- multiple_functions.h

auto foo(short a) -> void;
auto bar(short a) -> void;

// --- import_multiple_functions.carbon

library "[[@TEST_NAME]]";

import Cpp library "multiple_functions.h";

fn F() {
  Cpp.bar(1 as i16);
}

// ============================================================================
// Multiple overloaded functions
// ============================================================================

// --- multiple_overloaded_functions.h

auto foo(short a) -> void;
auto foo(int a) -> void;

// --- import_multiple_overloaded_functions.carbon

library "[[@TEST_NAME]]";

import Cpp library "multiple_overloaded_functions.h";

fn F() {
  Cpp.foo(1 as i32);
}

// ============================================================================
// No viable function found
// ============================================================================

// --- no_viable_function.h

auto foo(short a, int b) -> void;

// --- fail_import_no_viable_function.carbon

library "[[@TEST_NAME]]";

import Cpp library "no_viable_function.h";

fn F() {
  // CHECK:STDERR: fail_import_no_viable_function.carbon:[[@LINE+7]]:3: error: no viable function found during overloading resolution  [OverloadingNoViableFunctionFound]
  // CHECK:STDERR:   Cpp.foo(1 as i64);
  // CHECK:STDERR:   ^~~~~~~~~~~~~~~~~
  // CHECK:STDERR: fail_import_no_viable_function.carbon:[[@LINE+4]]:3: note: in call to a Cpp (overloaded) function here [InCallToOverloadedCppFunction]
  // CHECK:STDERR:   Cpp.foo(1 as i64);
  // CHECK:STDERR:   ^~~~~~~~~~~~~~~~~
  // CHECK:STDERR:
  Cpp.foo(1 as i64);
}

// ============================================================================
// Ambiguous overload found
// ============================================================================

// --- ambiguous_overload.h

auto foo(short a) -> void;
auto foo(int a) -> void;

// --- fail_import_ambiguous_overload.carbon

library "[[@TEST_NAME]]";

import Cpp library "ambiguous_overload.h";

fn F() {
  // CHECK:STDERR: fail_import_ambiguous_overload.carbon:[[@LINE+7]]:3: error: ambiguous candidates found during overloading resolution  [OverloadingAmbiguousCandidatesFound]
  // CHECK:STDERR:   Cpp.foo(1 as i64);
  // CHECK:STDERR:   ^~~~~~~~~~~~~~~~~
  // CHECK:STDERR: fail_import_ambiguous_overload.carbon:[[@LINE+4]]:3: note: in call to a Cpp (overloaded) function here [InCallToOverloadedCppFunction]
  // CHECK:STDERR:   Cpp.foo(1 as i64);
  // CHECK:STDERR:   ^~~~~~~~~~~~~~~~~
  // CHECK:STDERR:
  Cpp.foo(1 as i64);
}

// ============================================================================
// Deleted function found
// ============================================================================

// --- deleted_function.h

auto foo(short a) -> void;
auto foo(int a) -> void = delete;

// --- fail_import_deleted_function.carbon

library "[[@TEST_NAME]]";

import Cpp library "deleted_function.h";

fn F() {
  // CHECK:STDERR: fail_import_deleted_function.carbon:[[@LINE+7]]:3: error: overloading resolution succeeded, but refers to a deleted function [OverloadingDeletedFunctionFound]
  // CHECK:STDERR:   Cpp.foo(1 as i32);
  // CHECK:STDERR:   ^~~~~~~~~~~~~~~~~
  // CHECK:STDERR: fail_import_deleted_function.carbon:[[@LINE+4]]:3: note: in call to a Cpp (overloaded) function here [InCallToOverloadedCppFunction]
  // CHECK:STDERR:   Cpp.foo(1 as i32);
  // CHECK:STDERR:   ^~~~~~~~~~~~~~~~~
  // CHECK:STDERR:
  Cpp.foo(1 as i32);
}

