// --- local.carbon
library "[[@TEST_NAME]]";

fn F(a: i32) -> i32 {
  //@dump-sem-ir-begin
  let b: i32 = a;
  return b;
  //@dump-sem-ir-end
}

// --- symbolic.carbon
library "[[@TEST_NAME]]";

class C {}

fn F(c: C) {}

fn CallF() {
  //@dump-sem-ir-begin
  let c:! C = {};
  F(c);
  //@dump-sem-ir-end
}

