extend impl i32 as I {}

fn F() {
  // CHECK:STDERR: fail_extend_impl_scope.carbon:[[@LINE+4]]:3: error: `extend impl` can only be used in a class [ExtendImplOutsideClass]
  // CHECK:STDERR:   extend impl {} as I {}
