// --- impl_def.carbon

library "[[@TEST_NAME]]";

interface I {
  fn F(self) -> i32;
}

class A {
  var n: i32;
}

impl A as I {
  fn F(self: A) -> i32 {
    return self.n;
  }
}

// --- impl_use.carbon

import library "impl_def";

fn Call(a: A) -> i32 {
  return a.(I.F)();
}

