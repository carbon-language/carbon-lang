From: Christopher Di Bella <cjdb@google.com>
Date: Tue, 3 Nov 2026 01:39:02 +0000
Subject: [PATCH] Moves destructor type-trait deduction to a public function

This provides a canonical way to determine a type's destructor
information for both the standard library and projects using Clang as a
library.
---
 clang/include/clang/Sema/Sema.h   |  32 +++++++++
 clang/lib/Sema/SemaTypeTraits.cpp | 115 ++++++++++++++++++------------
 2 files changed, 102 insertions(+), 45 deletions(-)

diff --git a/clang/include/clang/Sema/Sema.h b/clang/include/clang/Sema/Sema.h
index 2c4986d56eed..dfa1be7a3c9d 100644
--- a/clang/include/clang/Sema/Sema.h
+++ b/clang/include/clang/Sema/Sema.h
@@ -15977,6 +15977,38 @@ public:
   ///@}
 };
 
+enum class DestructorFormat {
+  // SMF is deleted, private, protected, or otherwise inaccessible.
+  NotAvailable,
+
+  // SMF is trivial.
+  Trivial,
+
+  // SMF is non-trivial and nothrow.
+  NonTrivial,
+};
+
+/// Returns whether a type is trivially-destructible, non-trivially
+/// destructible, or cannot be destroyed in the current context.
+///
+/// It is possible for a type to have a trivial destructor without being
+/// trivially-destructible. For example, `struct S { ~S() = delete; };`
+/// has a trivial destructor: its destructor is non-virtual, all of its
+/// bases have trivial destructors, and all of its members are trivially
+/// destructible. `S` isn't trivially-destructible because its destructor
+/// has been deleted. Similarly, `class C { ~C() = default; }` isn't
+/// trivially-destructible because `~C()`---although trivial for the
+/// same reasons---is private.
+///
+/// This would ideally be placed in `QualType`, but libClangBasic
+/// doesn't include `Sema`.
+DestructorFormat GetDestructorFormat(Sema &S, const ASTContext &C,
+                                     SourceLocation Loc, QualType T);
+
+/// Returns whether a type's destructor is nothrow.
+bool IsDestructorNoThrow(Sema &S, const ASTContext &C, SourceLocation Loc,
+                         QualType T);
+
 DeductionFailureInfo
 MakeDeductionFailureInfo(ASTContext &Context, TemplateDeductionResult TDK,
                          sema::TemplateDeductionInfo &Info);
diff --git a/clang/lib/Sema/SemaTypeTraits.cpp b/clang/lib/Sema/SemaTypeTraits.cpp
index cb30ff9fd02d..91328c09750e 100644
--- a/clang/lib/Sema/SemaTypeTraits.cpp
+++ b/clang/lib/Sema/SemaTypeTraits.cpp
@@ -653,6 +653,67 @@ static ComparisonCategoryResult EvaluateTypeOrder(Sema &S, QualType LHS,
                     : ComparisonCategoryResult::Less;
 }
 
+DestructorFormat clang::GetDestructorFormat(Sema &S, const ASTContext &C,
+                                            SourceLocation Loc, QualType T) {
+  // C++14 [meta.unary.prop]:
+  //   For reference types, is_destructible<T>::value is true.
+  if (T->isReferenceType())
+    return DestructorFormat::Trivial;
+
+  // Objective-C++ ARC: autorelease types don't require destruction.
+  if (T->isObjCLifetimeType() &&
+      T.getObjCLifetime() == Qualifiers::OCL_Autoreleasing)
+    return DestructorFormat::Trivial;
+
+  // C++14 [meta.unary.prop]:
+  //   For incomplete types and function types, is_destructible<T>::value is
+  //   false.
+  if (T->isIncompleteType() || T->isFunctionType())
+    return DestructorFormat::NotAvailable;
+
+  DestructorFormat Result = DestructorFormat::Trivial;
+
+  // A type that requires destruction (via a non-trivial destructor or ARC
+  // lifetime semantics) is not trivially-destructible.
+  if (T.isDestructedType())
+    Result = DestructorFormat::NonTrivial;
+
+  // C++14 [meta.unary.prop]:
+  //   For object types and given U equal to remove_all_extents_t<T>, if the
+  //   expression std::declval<U&>().~U() is well-formed when treated as an
+  //   unevaluated operand (Clause 5), then is_destructible<T>::value is true
+  auto *RD = C.getBaseElementType(T)->getAsCXXRecordDecl();
+  if (!RD)
+    return Result;
+
+  CXXDestructorDecl *Destructor = S.LookupDestructor(RD);
+  if (!Destructor)
+    return DestructorFormat::NotAvailable;
+
+  //  C++14 [dcl.fct.def.delete]p2:
+  //    A program that refers to a deleted function implicitly or
+  //    explicitly, other than to declare it, is ill-formed.
+  if (Destructor->isDeleted())
+    return DestructorFormat::NotAvailable;
+
+  if (C.getLangOpts().AccessControl && Destructor->getAccess() != AS_public)
+    return DestructorFormat::NotAvailable;
+
+  return Result;
+}
+
+bool clang::IsDestructorNoThrow(Sema &S, const ASTContext &C,
+                                SourceLocation Loc, QualType T) {
+  auto *RD = C.getBaseElementType(T)->getAsCXXRecordDecl();
+  if (!RD)
+    return true;
+
+  CXXDestructorDecl *Destructor = S.LookupDestructor(RD);
+  auto *CPT = Destructor->getType()->castAs<FunctionProtoType>();
+  CPT = S.ResolveExceptionSpec(Loc, CPT);
+  return CPT && CPT->isNothrow();
+}
+
 static bool EvaluateUnaryTypeTrait(Sema &Self, TypeTrait UTT,
                                    SourceLocation KeyLoc,
                                    TypeSourceInfo *TInfo) {
@@ -878,52 +939,16 @@ static bool EvaluateUnaryTypeTrait(Sema &Self, TypeTrait UTT,
              !RD->hasNonTrivialCopyAssignment();
     return false;
   case UTT_IsDestructible:
+    return clang::GetDestructorFormat(Self, C, KeyLoc, T) !=
+           DestructorFormat::NotAvailable;
   case UTT_IsTriviallyDestructible:
-  case UTT_IsNothrowDestructible:
-    // C++14 [meta.unary.prop]:
-    //   For reference types, is_destructible<T>::value is true.
-    if (T->isReferenceType())
-      return true;
-
-    // Objective-C++ ARC: autorelease types don't require destruction.
-    if (T->isObjCLifetimeType() &&
